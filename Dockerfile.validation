FROM python:3.12.10-slim-bookworm@sha256:97983fa8cc88343512862c62307159a82261c3528dc025f79e5a3f7af43e50b4

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_TOOLS_CACHE_DIR=/tmp/pip-tools-cache \
    RUFF_CACHE_DIR=/tmp/ruff-cache \
    PYTHONPYCACHEPREFIX=/tmp/pycache \
    PYTEST_ADDOPTS=-p\ no:cacheprovider \
    PYTHONPATH=/workspace:/workspace/infra/hermes

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core && rm -rf /var/lib/apt/lists/*

# This image is validation-only. Production images install requirements.lock,
# while this target additionally installs the hashed development lock.
COPY requirements-dev.lock ./
RUN python -m pip install --require-hashes --no-deps -r requirements-dev.lock

COPY pyproject.toml requirements.lock ./
COPY apps ./apps
COPY config ./config
COPY database ./database
COPY scripts ./scripts
COPY tests ./tests
COPY README.md AGENTS.md .gitignore .env.example .editorconfig docker-compose.yml .dockerignore ./
COPY Dockerfile.validation ./
COPY Dockerfile.validation.dockerignore ./
COPY docs ./docs
COPY infra ./infra
COPY .github ./.github

CMD ["python", "-m", "pytest"]
